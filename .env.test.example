# Integration Test Environment Configuration
# Copy this file to .env.test and modify as needed

# Database Configuration
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vet_go_test
DB_PORT=5433
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# JWT Configuration
JWT_SECRET_KEY=test_secret_key_for_integration_testing_do_not_use_in_production
JWT_ISSUER=vet-go-integration-test
JWT_TIMEOUT_HOURS=24

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost
ENVIRONMENT=test

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
